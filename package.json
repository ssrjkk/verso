  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "Verso — editorial headless CMS and block page builder. Next.js 16, tRPC v11, Prisma 7 + SQLite, Better Auth.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssrjkk/verso.git"
  },
  "homepage": "https://github.com/ssrjkk/verso#readme",
  "bugs": {
    "url": "https://github.com/ssrjkk/verso/issues"
  },
  "keywords": [
    "nextjs",
    "headless-cms",
    "cms",
    "trpc",
    "prisma",
    "better-auth",
    "page-builder",
    "kanban",
    "typescript"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "pretest": "prisma generate",
    "pretest:e2e": "prisma generate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "predb:seed": "prisma generate",
    "predev": "prisma generate",
    "pretypecheck": "prisma generate"
  },
  "dependencies": {
