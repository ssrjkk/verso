    "better-auth": "^1.7.18",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "next": "16.4.5",
    "next-themes": "^0.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
