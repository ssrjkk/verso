{
  "name": "verso",
  "version": "0.1.0",
  "private": true,
  "description": "Verso — блочно-коллекционная Headless CMS + Page Builder в дизайн-системе Verso",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "pretest": "prisma generate",
    "pretest:e2e": "prisma generate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.25.0",
    "@trpc/react-query": "^11.25.0",
    "@trpc/server": "^11.25.0",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^13.0.3",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "next": "16.4.5",
    "next-themes": "^0.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
