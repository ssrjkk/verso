DATABASE_URL="file:./prisma/dev.db"
# Сгенерируй стойкий секрет: openssl rand -base64 32. Дефолт ниже — только для локалки.
# В production обязательны ≥32 символа и отсутствие change-me/test/demo.
BETTER_AUTH_SECRET="change-me-to-32-chars-minimum-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Дополнительные origin для auth-кук через запятую (прод-домены, preview).
# Пусто = только два URL выше.
# TRUSTED_ORIGINS="https://cms.example.com,https://preview.example.com"
# Только для e2e-стенда на throwaway-БД. НИКОГДА не выставлять в проде:
# отключает рейт-лимит входов.
# AUTH_RATELIMIT=off
# Явная маркировка тестового харнесса: разрешает короткий/демо-секрет и
# WEBHOOK_ALLOW_PRIVATE. В проде с этим флагом конфигурация небезопасна.
# VERSO_TEST_HARNESS=1
# Разрешает доставку вебхуков на loopback/RFC1918 (e2e-эхо 127.0.0.1).
# Только вместе с VERSO_TEST_HARNESS=1; иначе в продакшене процесс падает.
# WEBHOOK_ALLOW_PRIVATE=1
# Разрешает `npm run db:seed` с демо-пользователями на production-инстансе.
# НИКОГДА не выставлять на реальном проде: это общеизвестный пароль.
# SEED_ALLOW=1
# Секрет внешнего cron для POST /api/cron/publish-due и /api/cron/webhooks
# (Bearer). Без него маршруты отвечают 503 (fail closed).
# Сгенерируй: openssl rand -base64 32.
# CRON_SECRET="change-me"
# Опциональный интервал самопубликации в мс (self-hosted без внешнего cron).
# Выключен по умолчанию; внешний cron предпочтительнее.
# PUBLISH_DUE_TICK_MS=60000
# Outbox вебхуков: доставка включена по умолчанию каждые 60с, чтобы PENDING
# не зависели от внешнего cron. 0 — выключить тик и использовать
# POST /api/cron/webhooks; некорректное значение откатывается к 60000.
# WEBHOOK_DRAIN_TICK_MS=60000
# Повторы доставки: максимум попыток, база экспоненциального backoff (мс),
# lease зависшей DELIVERING-доставки (мс) и размер пачки на один drain.
# WEBHOOK_MAX_ATTEMPTS=8
# WEBHOOK_BASE_BACKOFF_MS=60000
# WEBHOOK_LEASE_MS=600000
# WEBHOOK_DRAIN_BATCH=50
# Сколько дней хранить терминальные доставки (DELIVERED/FAILED). Чистка
# идёт при тике или cron не чаще раза в 6 часов. 0 — хранить бессрочно.
# WEBHOOK_RETENTION_DAYS=30
