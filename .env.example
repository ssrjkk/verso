DATABASE_URL="file:./prisma/dev.db"
# Сгенерируй стойкий секрет: openssl rand -base64 32. Дефолт ниже — только для локалки.
BETTER_AUTH_SECRET="change-me-to-32-chars-minimum-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Дополнительные origin для auth-кук через запятую (прод-домены, preview).
# Пусто = только два URL выше.
# TRUSTED_ORIGINS="https://cms.example.com,https://preview.example.com"
# Только для e2e-стенда на throwaway-БД. НИКОГДА не выставлять в проде:
# отключает рейт-лимит входов и проверку стойкости BETTER_AUTH_SECRET.
# AUTH_RATELIMIT=off
# Разрешает доставку вебхуков на loopback/RFC1918 (e2e-эхо 127.0.0.1).
# Только вместе с AUTH_RATELIMIT=off; в продакшене с этим флагом процесс падает.
# WEBHOOK_ALLOW_PRIVATE=1
# Секрет внешнего cron для POST /api/cron/publish-due (Bearer). Без него
# маршрут отвечает 503 (fail closed). Сгенерируй: openssl rand -base64 32.
# CRON_SECRET="change-me"
# Опциональный интервал самопубликации в мс (self-hosted без внешнего cron).
# Выключен по умолчанию; внешний cron предпочтительнее.
# PUBLISH_DUE_TICK_MS=60000
