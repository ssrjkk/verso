DATABASE_URL="file:./prisma/dev.db"
# Сгенерируй стойкий секрет: openssl rand -base64 32. Дефолт ниже — только для локалки.
BETTER_AUTH_SECRET="change-me-to-32-chars-minimum-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Только для e2e-стенда на throwaway-БД. НИКОГДА не выставлять в проде:
# отключает рейт-лимит входов и проверку стойкости BETTER_AUTH_SECRET.
# AUTH_RATELIMIT=off
# Разрешает доставку вебхуков на loopback/RFC1918 (e2e-эхо 127.0.0.1).
# Только вместе с AUTH_RATELIMIT=off; в продакшене с этим флагом процесс падает.
# WEBHOOK_ALLOW_PRIVATE=1
